results/*/train_episodes.csv
results/*/config.json
results/*/log.txt
results/*/DONE

# Plots and LaTeX intermediate files are generated on demand.
figures/
paper/figure_*.pdf
paper/figure_*.png
paper/table_*_revised.tex
paper/main.pdf
paper/*.aux
paper/*.log
paper/*.fls
paper/*.fdb_latexmk
paper/*.xdv
paper/*.out
paper/*.synctex.gz
